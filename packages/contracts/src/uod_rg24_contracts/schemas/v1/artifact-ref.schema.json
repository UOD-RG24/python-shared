{
  "$defs": {
    "ArtifactState": {
      "enum": [
        "reserved",
        "writing",
        "committed",
        "failed",
        "quarantined",
        "deleted"
      ],
      "title": "ArtifactState",
      "type": "string"
    },
    "JsonValue": {},
    "Modality": {
      "enum": [
        "mrna",
        "protein",
        "clinical",
        "mixed"
      ],
      "title": "Modality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Artifactid",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "title": "Createdat",
      "type": "string"
    },
    "datasetId": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Datasetid",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "kind": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Kind",
      "type": "string"
    },
    "modality": {
      "anyOf": [
        {
          "$ref": "#/$defs/Modality"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schemaId": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Schemaid",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ArtifactState"
    }
  },
  "required": [
    "artifactId",
    "datasetId",
    "kind",
    "schemaId",
    "state",
    "sha256",
    "createdAt"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
