{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Artifactid",
      "type": "string"
    },
    "counts": {
      "patternProperties": {
        ".*\\S.*": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Counts",
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "generatedAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$",
      "title": "Generatedat",
      "type": "string"
    },
    "metrics": {
      "patternProperties": {
        ".*\\S.*": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Metrics",
      "type": "object"
    },
    "schemaVersion": {
      "const": "artifact-qc/1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "warnings": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "artifactId",
    "generatedAt"
  ],
  "title": "QCSummaryV1",
  "type": "object"
}
